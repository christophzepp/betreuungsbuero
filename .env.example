# Diese Datei nach .env kopieren. Die echte .env bleibt ausschließlich auf
# dem jeweiligen Docker-Server und wird niemals bei GitHub gespeichert.

# Testkanal:
APP_IMAGE=ghcr.io/derzerpoo/betreuungsbuero-beta:beta
# Später auf dem Produktivserver:
# APP_IMAGE=ghcr.io/derzerpoo/betreuungsbuero:stable

APP_PORT=8935
TZ=Europe/Berlin
PUBLIC_BASE_URL=http://localhost:8935
COOKIE_SECURE=0

# Drei unterschiedliche Zufallswerte einsetzen. Je Wert beispielsweise:
#   openssl rand -hex 32
SESSION_SECRET=
ENCRYPTION_KEY=
SETUP_TOKEN=

CALENDAR_SYNC_INTERVAL_SECONDS=60
MAILBOX_WATCH=1
REQUEST_TIMEOUT_MS=3600000
ENABLE_DOCUMENT_MIGRATION=0
