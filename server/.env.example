# Kopieren nach .env und mit echten Werten fuellen (niemals .env einchecken).

# Zufaelliger, langer String zum Signieren der Session-Cookies.
SESSION_SECRET=change-me-to-a-long-random-string

# 32-Byte-Schluessel (Hex, 64 Zeichen) fuer AES-256-GCM.
# Erzeugen z.B. mit: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=change-me-to-a-64-char-hex-string

# Separater Wiederherstellungsschluessel fuer Sicherheit.json.enc und
# Zugangsdaten.json.enc. Im Normalfall richtet ein Admin ihn nach dem ersten
# Start im Admin-Panel ein; der Server legt ihn dann unter runtime/secrets/
# ab. Der Wert wird dort nie angezeigt und nie in eine Gesamtsicherung
# aufgenommen. Die beim Einrichten angebotene Kopie extern verwahren.
#
# Rueckwaertskompatibler Startwert/Fallback fuer automatisierte Installationen:
# Altbestand ab 16 Zeichen kann gelesen werden, gilt aber als Legacy-Schluessel
# und muss vor neuen Sicherheitsabbildern bzw. einer Gesamtsicherung rotiert
# werden. Fuer einen sofort voll nutzbaren Fallback sind exakt 32 zufaellige
# Byte als 64-stelliges Hex oder als drk1_<43 Zeichen Base64URL> erforderlich.
# Sobald im Admin-Panel ein Schluessel eingerichtet wurde, hat dessen
# geschuetzte Laufzeitdatei Vorrang.
DOCUMENT_RECOVERY_KEY=
#
# Optionaler abweichender Ort fuer die Laufzeitdatei. Er MUSS ausserhalb von
# DOCUMENTS_DATA_ROOT und des Dokumentenspeichers liegen.
# DOCUMENT_RECOVERY_KEY_FILE=/sicherer/externer/pfad/document-recovery-key

# Docker-Compose: bereits vorhandenes getrenntes Sicherungsziel und ein
# separater, nur lesbar eingebundener Secret-Ordner. Im Secret-Ordner liegen
# restic-password und optional heartbeat-secret sowie – nur wenn das Backend
# Provider-Variablen braucht – restic-backend.env jeweils mit Modus 0600; der
# Ordner selbst sollte Modus 0700 besitzen.
# BACKUP_HOST_DIR=/Volumes/EXTERNE-SICHERUNG/Betreuungsbuero
# BACKUP_SECRET_HOST_DIR=/ABSOLUTER/PFAD/ZU/backup-secrets
# OFFSITE_MAINTENANCE_STATUS_HOST_DIR=/ABSOLUTER/PFAD/ZU/offsite-maintenance-status
# OFFSITE_MAINTENANCE_SECRET_HOST_DIR=/ABSOLUTER/PFAD/ZU/offsite-maintenance-delete-secrets
# TOTAL_BACKUP_OFFSITE_MAINTENANCE_MAX_AGE_HOURS=192
# Für SFTP oder nicht authentifiziertes REST leer lassen:
# TOTAL_BACKUP_RESTIC_ENV_FILE=/run/betreuungsbuero-backup-secrets/restic-backend.env
#
# Nur beim getrennten One-shot setzen; das zugehörige Delete-Secret-Verzeichnis
# wird niemals in den Haupt-App-Container gemountet:
# OFFSITE_MAINTENANCE_REPOSITORY=s3:https://S3-ENDPUNKT/BUCKET/PFAD
# Für SFTP oder nicht authentifiziertes REST leer lassen:
# OFFSITE_MAINTENANCE_CREDENTIAL_ENV_FILE=/run/betreuungsbuero-offsite-maintenance-secrets/restic-backend.env
# OFFSITE_MAINTENANCE_JOB_ID=<exakte-ID-des-App-Zeitplans>
# OFFSITE_MAINTENANCE_TAG=betreuungsbuero
# OFFSITE_MAINTENANCE_KEEP_DAILY=14
# OFFSITE_MAINTENANCE_KEEP_MONTHLY=12
# OFFSITE_MAINTENANCE_KEEP_YEARLY=10

PORT=8935

# OPTIONAL, nur fuer die Erstinbetriebnahme (Seite /setup auf einer noch leeren Datenbank).
# Ist hier ein Wert gesetzt, muss er beim Einrichten zusaetzlich eingegeben werden - sinnvoll,
# wenn der Server schon vor der Einrichtung oeffentlich erreichbar ist. Leer/nicht gesetzt =
# /setup ist frei zugaenglich, solange noch KEIN Nutzerkonto existiert. Sobald das erste Konto
# angelegt ist, ist /setup dauerhaft gesperrt und diese Variable wirkungslos.
SETUP_TOKEN=

# Oeffentlich erreichbare Basis-URL des Servers (ohne abschliessenden Slash), z.B. deine spaetere
# Cloudflare-Tunnel-Domain. Wird als OAuth-Redirect-URI fuer Google-/Microsoft-Kalender-Verbindungen
# gebraucht (Plan Abschnitt AE) - muss exakt mit der Redirect-URI uebereinstimmen, die beim Anlegen
# der App in der Google-Cloud-Console bzw. im Azure-Portal hinterlegt wird:
#   <PUBLIC_BASE_URL>/api/admin/calendar-connections/oauth/callback/google
#   <PUBLIC_BASE_URL>/api/admin/calendar-connections/oauth/callback/microsoft
# Ohne gesetzten Wert wird http://localhost:<PORT> verwendet (nur fuer lokale Tests geeignet).
PUBLIC_BASE_URL=

# Explizit von docker-compose.yml übernommene, nichtgeheime Laufzeitwerte.
# Nicht benötigte Werte können auf den sicheren Vorgaben bleiben. Eine .env
# wird bewusst nicht pauschal als env_file in den Container durchgereicht.
TZ=Europe/Berlin
CALENDAR_SYNC_INTERVAL_SECONDS=60
MAILBOX_WATCH=1
REQUEST_TIMEOUT_MS=3600000
ENABLE_DOCUMENT_MIGRATION=0
EXT_AI_PROVIDER=
EXT_UPDATE_VERSION=
EXT_UPDATE_XPI_URL=
APP_FILE=Betreuungsbuero_Dokumentenassistent_v0_7.html
DOK_GRAPH_BASE=https://graph.microsoft.com/v1.0
DOK_MS_AUTH=https://login.microsoftonline.com/common/oauth2/v2.0/authorize
DOK_MS_TOKEN=https://login.microsoftonline.com/common/oauth2/v2.0/token
DOK_GD_AUTH=https://accounts.google.com/o/oauth2/v2/auth
DOK_GD_TOKEN=https://oauth2.googleapis.com/token
DOK_GD_API=https://www.googleapis.com/drive/v3
DOK_GD_UPLOAD=https://www.googleapis.com/upload/drive/v3

# Für einen reproduzierbaren Neuaufbau möglichst eine unveränderliche
# Registry-Referenz inklusive Digest verwenden, nicht nur ein bewegliches Tag.
# APP_IMAGE=registry.example/betreuungsbuero-server@sha256:...
